[Unit]
Description=Literature knowledge graph candidate extraction worker
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/agent_culti_demo
EnvironmentFile=/opt/agent_culti_demo/.env
ExecStart=/opt/agent_culti_demo/.venv/bin/python scripts/run_knowledge_graph_worker.py --shadow
Restart=on-failure
RestartSec=10
TimeoutStopSec=960
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
