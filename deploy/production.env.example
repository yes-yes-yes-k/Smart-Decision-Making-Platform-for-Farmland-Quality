# 生产环境变量配置模板
# 复制为 .env 并填写实际值: copy deploy\production.env.example .env

# === 应用安全（必填）===
# 生成密钥: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=请替换为随机生成的64位十六进制密钥
JWT_SECRET_KEY=请替换为另一个随机生成的密钥

# === 数据库 ===
# 生产环境使用 SQLite，数据库文件位于 instance/production.db
# 无需额外配置，由 init_db.py 自动创建

# === SiliconFlow LLM 服务（必填）===
SILICONFLOW_API_KEY=replace-with-secret-from-your-secret-manager
SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
SILICONFLOW_EMBED_MODEL=BAAI/bge-m3
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 单次最终总结调用的超时与重试次数；保持短超时，防止聊天请求被重试放大。
SILICONFLOW_LLM_TIMEOUT=200
SILICONFLOW_LLM_MAX_RETRIES=0

# === ChromaDB 向量库 ===
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=enterprise_kb

# === 知识图谱存储 ===
# AGE 必须先完成健康检查、v0.4 迁移和 JSON/AGE 双读验收；未通过前保持 json。
KG_GRAPH_STORE=json
KG_AGE_GRAPH_NAME=cultivated_land_kg
KG_AUDIT_EXPORT_DIR=artifacts/knowledge_platform/release_audits

# === 文件上传 ===
UPLOAD_FOLDER=./uploads
# CAJ 论文解析（安装 caj2pdf 并加入 PATH 时可留空）
# CAJ_CONVERTER_PATH=C:\tools\caj2pdf\caj2pdf.exe
CAJ_CONVERTER_TIMEOUT=300
# 文献入库：默认仅保留原始 CAJ 和转换溯源；设为 true 时长期保留派生 PDF。
LITERATURE_RETAIN_DERIVED_PDF=false
# 管理员批次 staging token 到绝对目录的 JSON 映射，例如：{"initial":"D:\\staging\\papers"}
LITERATURE_STAGING_ROOTS_JSON={}
INGESTION_WORKERS=2
INGESTION_MAX_QUEUED=100

# === 并发控制 ===
# 0 表示按 CPU 核数自动计算（2-6 之间）
MAX_CONCURRENT_MODELS=0

# === 环境标识 ===
FLASK_ENV=production
ENV=production

# === LangSmith 监控（生产环境默认开启） ===
# LangSmith 可观测性平台，追踪多智能体全链路执行
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=请替换为LangSmith API Key
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=agent-culti-demo
# 独立图谱候选抽取 worker；与 API 使用相同配置指纹。
# GraphRAG 必须装在独立环境；运行 worker 前先 --check。
# KG_GRAPHRAG_PYTHON=/opt/agent_culti_demo/.tools/graphrag-runtime/bin/python
KG_EXTRACTION_BASE_URL=http://127.0.0.1:8001/v1
KG_EXTRACTION_MODEL=
KG_EXTRACTION_API_KEY=
KG_EXTRACTION_MAX_TOKENS=4096
KG_EXTRACTION_REQUEST_TIMEOUT=120
# 仅在获准发送已审核公共文献分块后启用；其他外部地址仍被拒绝。
KG_EXTRACTION_ALLOW_SILICONFLOW=false
