# 生产环境变量配置模板
# 复制为 .env 并填写实际值: copy deploy\production.env.example .env

# === 应用安全（必填）===
# 生成密钥: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=请替换为随机生成的64位十六进制密钥
JWT_SECRET_KEY=请替换为另一个随机生成的密钥

# === 数据库 ===
# 生产环境使用 SQLite，数据库文件位于 instance/production.db
# 无需额外配置，由 init_db.py 自动创建

# === SiliconFlow LLM 服务（必填）===
SILICONFLOW_API_KEY=replace-with-secret-from-your-secret-manager
SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V3
SILICONFLOW_EMBED_MODEL=BAAI/bge-m3
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 单次最终总结调用的超时与重试次数；保持短超时，防止聊天请求被重试放大。
SILICONFLOW_LLM_TIMEOUT=200
SILICONFLOW_LLM_MAX_RETRIES=0

# === ChromaDB 向量库 ===
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=enterprise_kb

# === 耕地质量知识图谱 v0.4 ===
KG_RETRIEVAL_ENABLED=true
KG_GRAPH_PATH=./artifacts/minimal_kg/cultivated_land_minimal_graph_v0.4.json
KG_MANIFEST_PATH=./artifacts/minimal_kg/cultivated_land_minimal_graph_v0.4.manifest.json
KG_EXPECTED_SHA256=481ca6206a77c842b4287d7cec5b57f10837e3037c8a2a9ed7648713ea2a7899
KG_RETRIEVAL_TOP_K=5
# 生产首次部署保持 shadow；健康检查和影子指标稳定后再改为 canary。
KG_ROLLOUT_MODE=shadow
KG_CANARY_PERCENT=10
KG_CANARY_USER_IDS=
KG_PROFESSIONAL_EVIDENCE_ENABLED=true
KG_FAIL_CLOSED_AUTHORITATIVE=true

# === 文件上传 ===
UPLOAD_FOLDER=./uploads

# === 并发控制 ===
# 0 表示按 CPU 核数自动计算（2-6 之间）
MAX_CONCURRENT_MODELS=0

# === 环境标识 ===
FLASK_ENV=production
ENV=production

# === LangSmith 监控（生产环境默认开启） ===
# LangSmith 可观测性平台，追踪多智能体全链路执行
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=请替换为LangSmith API Key
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=agent-culti-demo
