+                {"metric": "soc_confidence", "value": pred["soc_confidence"]},
+                {"metric": "dose_prediction", "value": pred["dose_prediction"], "unit": "t/ha"},
+                {"metric": "dose_confidence", "value": pred["dose_confidence"]},
+            ],
+            "sources": [],
+        })
