+FERTILITY_KEYWORDS = [
+    "鏈夋満纰?, "SOC", "soc",
+    "鏂界敤閲?, "鏂借偉閲?, "鏂借偉", "Dose", "dose", "鍓傞噺", "鏂藉灏戣偉",
