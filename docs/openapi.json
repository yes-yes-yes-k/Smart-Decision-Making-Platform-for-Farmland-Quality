              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat/": {
      "post": {
        "tags": ["聊天"],
        "summary": "智能问答（多智能体协作）",
        "description": "统一智能路由入口，根据问题类型（question_type 0-5）自动路由到 RAG 链或多智能体框架。多智能体框架基于 question_type 1:1 映射到对应单一专业智能体（1→model-1 稳定性、2→model-4 酸化、3→model-3 障碍诊断、4→model-6 肥力、5→model-7 质量等级），知识性问题（type 0）走 RAG 链路",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "用户问题"
                  },
                  "conversation_id": {
                    "type": "integer",
                    "description": "对话ID，不传则创建新对话"
                  },
                  "context": {
                    "$ref": "#/components/schemas/ChatContext"
                  },
                  "area_code": {
                    "type": "string",
                    "description": "区域代码，用于专业模型执行（model-1/3/4 按 area_code 查 DB）",
                    "example": "lechang"
                  },
                  "parcel_id": {
                    "type": "string",
                    "description": "地块ID（数字字符串，给 model-1/3/4 查 DB），农户端问题或 type 5 问题建议携带",
                    "example": "1"
                  },
                  "parcel_code": {
                    "type": "string",
                    "description": "地块代码（字母数字，给 model-7 调 Fortran exe），type 5 质量等级评价必需",
                    "example": "A0001"
                  }
                },
                "required": ["message"]
              },
              "example": {
                "message": "我的田耕地质量等级是多少？",
                "conversation_id": 1,
                "area_code": "lechang",
                "parcel_id": "1",
                "parcel_code": "A0001",
                "context": {
                  "target_ph": 6.0,
                  "soil_depth": 20
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "answer": {
                          "type": "string",
                          "description": "综合回答内容",
                          "example": "根据评估结果，建议施用石灰..."
                        },
                        "sources": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Source"
                          }
                        },
                        "question_type": {
                          "type": "integer",
                          "description": "问题类型：0=知识性问题（走RAG）, 1=稳定性/退化风险, 2=酸化改良, 3=障碍诊断, 4=肥力/SOC/Dose, 5=耕地质量等级评价"
                        },
                        "model_results": {
                          "$ref": "#/components/schemas/MultiAgentResult"
                        },
                        "message_id": {
                          "type": "integer"
                        },
                        "agents_invoked": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "调用的智能体ID列表（1:1 映射，仅含单一模型），仅在触发多智能体时返回",
                          "example": ["model-7"]
                        },
                        "recommendations": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "综合建议列表，仅在触发多智能体时返回",
                          "example": ["建议施用石灰50kg/亩调节土壤酸度", "增施有机肥提升有机质含量"]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
