    "/api/v1/models/run": {
      "post": {
        "tags": ["模型"],
        "summary": "执行专题模型",
        "description": "执行指定的专题模型，支持8个模型：spatial-structure-analysis、soil-indicator-analysis、obstacle-factor-identification、acidification-governance、organic-matter-improvement、stability-risk-evaluation、quality-grade-evaluation、multi-factor-collaborative-improvement",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model_id": {
                    "type": "string",
                    "description": "模型ID",
                    "example": "acidification-governance"
                  },
                  "area_code": {
                    "type": "string",
                    "description": "区域代码",
                    "example": "lechang"
                  },
                  "longitude": {
                    "type": "number",
                    "description": "经度坐标（可选）"
                  },
                  "latitude": {
                    "type": "number",
                    "description": "纬度坐标（可选）"
                  },
                  "indicators": {
                    "type": "object",
                    "description": "指标参数（可选）"
                  },
                  "context": {
                    "type": "object",
                    "description": "上下文参数（可选）"
                  }
                },
                "required": ["model_id"]
              },
              "example": {
                "model_id": "acidification-governance",
                "area_code": "lechang",
                "target_ph": 6.0
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "$ref": "#/components/schemas/ModelRunResult"
                    }
                  }
                }
              }
            }
          },
          "400": {
