{
  "openapi": "3.0.1",
  "info": {
    "title": "耕地土壤酸化治理智能问答系统 API",
    "description": "集成 RAG、Function Calling 和多智能体架构的统一框架 API，底层引擎基于 ai_culti_demo",
    "version": "1.3.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "本地开发环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": ["认证"],
        "summary": "用户登录",
        "description": "用户登录获取 JWT Token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "description": "用户名"
                  },
                  "password": {
                    "type": "string",
                    "description": "密码"
                  }
                },
                "required": ["username", "password"]
              },
              "example": {
                "username": "admin",
                "password": "admin123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "token": {
                          "type": "string",
                          "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
                        },
                        "user": {
                          "$ref": "#/components/schemas/User"
                        }
                      }
                    },
                    "message": {
                      "type": "string",
                      "example": "登录成功"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "认证失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": ["认证"],
        "summary": "注册用户",
        "description": "管理员创建新用户（需要 admin 权限）",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "description": "用户名"
                  },
                  "password": {
                    "type": "string",
                    "description": "密码"
                  },
                  "nickname": {
                    "type": "string",
                    "description": "昵称"
                  },
                  "role": {
                    "type": "string",
                    "description": "角色",
                    "enum": ["admin", "user"]
                  }
                },
                "required": ["username", "password"]
              },
              "example": {
                "username": "newuser",
                "password": "password123",
                "nickname": "新用户",
                "role": "user"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "$ref": "#/components/schemas/User"
                    },
                    "message": {
                      "type": "string",
                      "example": "用户创建成功"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "权限不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": ["认证"],
        "summary": "获取当前用户",
        "description": "获取当前登录用户信息",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "用户不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat/": {
      "post": {
        "tags": ["聊天"],
        "summary": "智能问答（多智能体协作）",
        "description": "统一智能路由入口，根据问题类型自动路由到 RAG 链或多智能体框架。多智能体框架基于用户角色（省市管理端/县域执行端/农户种植端）路由到对应的专业智能体组合，返回结构化协作结果",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "用户问题"
                  },
                  "conversation_id": {
                    "type": "integer",
                    "description": "对话ID，不传则创建新对话"
                  },
                  "context": {
                    "$ref": "#/components/schemas/ChatContext"
                  },
                  "area_code": {
                    "type": "string",
                    "description": "区域代码，用于专业模型执行",
                    "example": "lechang"
                  }
                },
                "required": ["message"]
              },
              "example": {
                "message": "如何治理强酸性耕地？",
                "conversation_id": 1,
                "area_code": "lechang",
                "context": {
                  "target_ph": 6.0,
                  "soil_depth": 20
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "answer": {
                          "type": "string",
                          "description": "综合回答内容",
                          "example": "根据评估结果，建议施用石灰..."
                        },
                        "sources": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Source"
                          }
                        },
                        "question_type": {
                          "type": "integer",
                          "description": "0=RAG问答, 1=酸化治理, 2=多项协同提升, 3=有机质提升"
                        },
                        "model_results": {
                          "$ref": "#/components/schemas/MultiAgentResult"
                        },
                        "message_id": {
                          "type": "integer"
                        },
                        "role": {
                          "type": "string",
                          "description": "用户角色（多智能体框架识别），仅在触发多智能体时返回",
                          "enum": ["省市管理端", "县域执行端", "农户种植端"]
                        },
                        "agents_invoked": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "调用的智能体ID列表，仅在触发多智能体时返回",
                          "example": ["model-1", "model-3"]
                        },
                        "recommendations": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "综合建议列表，仅在触发多智能体时返回",
                          "example": ["建议施用石灰50kg/亩调节土壤酸度", "增施有机肥提升有机质含量"]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat/conversations": {
      "get": {
        "tags": ["聊天"],
        "summary": "获取对话列表",
        "description": "获取当前用户的所有对话",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Conversation"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["聊天"],
        "summary": "创建对话",
        "description": "创建新对话",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "对话标题"
                  }
                }
              },
              "example": {
                "title": "新对话"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Conversation"
                    },
                    "message": {
                      "type": "string",
                      "example": "对话创建成功"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat/conversations/{id}": {
      "delete": {
        "tags": ["聊天"],
        "summary": "删除对话",
        "description": "删除指定对话",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "message": {
                      "type": "string",
                      "example": "对话删除成功"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "对话不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat/conversations/{id}/messages": {
      "get": {
        "tags": ["聊天"],
        "summary": "获取对话消息",
        "description": "获取指定对话的所有消息",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Message"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "对话不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models/": {
      "get": {
        "tags": ["模型"],
        "summary": "获取模型列表",
        "description": "获取所有可用的专业模型（由核心引擎提供，共6个专题模型）",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "area_code",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "lechang"
            },
            "description": "区域代码"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ThematicModel"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models/run": {
      "post": {
        "tags": ["模型"],
        "summary": "执行专题模型",
        "description": "执行指定的专题模型，支持6个模型：spatial-structure-analysis、soil-indicator-analysis、obstacle-factor-identification、acidification-governance、organic-matter-improvement、multi-factor-collaborative-improvement",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model_id": {
                    "type": "string",
                    "description": "模型ID",
                    "example": "acidification-governance"
                  },
                  "area_code": {
                    "type": "string",
                    "description": "区域代码",
                    "example": "lechang"
                  },
                  "longitude": {
                    "type": "number",
                    "description": "经度坐标（可选）"
                  },
                  "latitude": {
                    "type": "number",
                    "description": "纬度坐标（可选）"
                  },
                  "indicators": {
                    "type": "object",
                    "description": "指标参数（可选）"
                  },
                  "context": {
                    "type": "object",
                    "description": "上下文参数（可选）"
                  }
                },
                "required": ["model_id"]
              },
              "examples": {
                "spatial_structure_analysis": {
                  "summary": "空间结构解析",
                  "value": {
                    "model_id": "spatial-structure-analysis",
                    "area_code": "lechang"
                  }
                },
                "soil_indicator_analysis": {
                  "summary": "土壤关键指标多维解析",
                  "value": {
                    "model_id": "soil-indicator-analysis",
                    "area_code": "lechang",
                    "indicators": {
                      "ph": 5.2,
                      "organic_matter": 18.5,
                      "available_nitrogen": 92
                    }
                  }
                },
                "obstacle_factor_identification": {
                  "summary": "主要障碍因素识别",
                  "value": {
                    "model_id": "obstacle-factor-identification",
                    "area_code": "lechang",
                    "longitude": 113.3565,
                    "latitude": 25.1288
                  }
                },
                "acidification_governance": {
                  "summary": "土壤酸化治理",
                  "value": {
                    "model_id": "acidification-governance",
                    "area_code": "lechang",
                    "longitude": 113.3565,
                    "latitude": 25.1288,
                    "indicators": {
                      "ph": 5.2
                    }
                  }
                },
                "organic_matter_improvement": {
                  "summary": "土壤有机质提升",
                  "value": {
                    "model_id": "organic-matter-improvement",
                    "area_code": "lechang",
                    "longitude": 113.3565,
                    "latitude": 25.1288,
                    "indicators": {
                      "organic_matter": 18.5
                    }
                  }
                },
                "multi_factor_collaborative_improvement": {
                  "summary": "多项协同提升",
                  "value": {
                    "model_id": "multi-factor-collaborative-improvement",
                    "area_code": "lechang",
                    "longitude": 113.3565,
                    "latitude": 25.1288,
                    "indicators": {
                      "ph": 5.2,
                      "organic_matter": 18.5
                    },
                    "context": {
                      "request_id": "model-demo-001",
                      "source": "api-documentation-example"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "$ref": "#/components/schemas/ModelRunResult"
                    }
                  }
                },
                "example": {
                  "status": "ok",
                  "data": {
                    "status": "ok",
                    "model": {
                      "model_id": "multi-factor-collaborative-improvement",
                      "name": "耕地质量多项协同提升模型",
                      "purpose": "综合多个专题模型的占位结果，形成分区分类的综合提升建议。",
                      "minimum_inputs": ["area_code"],
                      "recommended_layers": ["quality-overview", "acidification-risk", "organic-matter"],
                      "dependent_models": ["acidification-governance", "organic-matter-improvement", "obstacle-factor-identification"]
                    },
                    "area": {
                      "code": "lechang",
                      "name": "乐昌市",
                      "level": "county",
                      "province": "广东省"
                    },
                    "summary": "多项协同提升模型已综合多个专题模型的 Demo 结果，形成分区分类的综合建议。",
                    "findings": [
                      {
                        "title": "协同组合",
                        "content": "协同提升模型综合酸化治理、障碍识别和有机质提升等专题结果生成总建议。"
                      },
                      {
                        "title": "分区分类",
                        "content": "首版按全县重点治理区、常规提升区和持续监测区三类输出综合方向。"
                      }
                    ],
                    "recommended_layers": ["quality-overview", "acidification-risk", "organic-matter"],
                    "recommendations": ["先按主要障碍与提升主题划分重点治理区。", "后续可在镇域或格网尺度叠加真实模型输出做精细分区。"],
                    "lineage": {
                      "catalog": "data/lechang/catalog.json",
                      "referenced_assets": ["external/AcidMap", "external/AcidificationModel/api"],
                      "runtime_dependency": "none",
                      "recommended_layers": ["quality-overview", "acidification-risk", "organic-matter"]
                    },
                    "reliability": {
                      "level": "demo_stub",
                      "message": "当前专题模型结果仅用于 Demo 演示多模型调用契约，不代表真实专业模型结论。"
                    },
                    "fallback": {
                      "used": false,
                      "fields": [],
                      "strategy": "缺少坐标时按县域级占位结果返回；缺少指标时使用 Demo 默认上下文补齐。"
                    },
                    "context": {
                      "request_id": "model-demo-001",
                      "source": "api-documentation-example"
                    },
                    "dependent_models": ["acidification-governance", "organic-matter-improvement", "obstacle-factor-identification"],
                    "zoning_recommendations": [
                      {
                        "zone": "重点治理区",
                        "focus": "酸化风险与综合障碍叠加区域优先核验并治理。"
                      },
                      {
                        "zone": "常规提升区",
                        "focus": "以有机质提升和耕地培肥措施为主，保持常态化改良。"
                      },
                      {
                        "zone": "持续监测区",
                        "focus": "维持监测和图层复核，为后续真实模型替换保留比对基线。"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "error",
                  "error": {
                    "code": "MISSING_MODEL_ID",
                    "message": "调用专题模型时必须提供 model_id"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/docs/": {
      "get": {
        "tags": ["文档"],
        "summary": "获取文档列表",
        "description": "获取当前用户上传的所有文档",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Document"
                      }
                    }
                  }
                }
