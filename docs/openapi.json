            }
          }
        }
      }
    },
    "/api/v1/docs/upload": {
      "post": {
        "tags": ["文档"],
        "summary": "上传文档",
        "description": "上传文档并自动解析为向量",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "文档文件（支持 txt, md, pdf, docx, xlsx）"
                  }
