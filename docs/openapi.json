    "/api/v1/county/overview": {
      "get": {
        "tags": ["县域诊断"],
        "summary": "获取县域概览",
        "description": "获取指定区域的土壤数据概览，包括基础图层、派生图层和来源追溯（数据由核心引擎提供）",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "area_code",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "lechang"
            },
            "description": "区域代码"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "$ref": "#/components/schemas/CountyOverview"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/county/diagnose": {
      "post": {
        "tags": ["县域诊断"],
        "summary": "县域诊断分析",
        "description": "综合评估指定区域的土壤酸化状况，支持三种诊断主题（酸化诊断、质量总览、治理提升）",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string",
                    "description": "诊断主题",
                    "enum": ["acidification", "quality", "improvement"],
                    "example": "acidification"
                  },
                  "area_code": {
                    "type": "string",
                    "description": "区域代码",
                    "example": "lechang"
                  },
                  "longitude": {
                    "type": "number",
                    "description": "经度坐标（可选）"
                  },
                  "latitude": {
                    "type": "number",
                    "description": "纬度坐标（可选）"
                  },
                  "target_ph": {
                    "type": "number",
                    "description": "目标pH值（可选）",
                    "example": 6.0
                  }
                },
                "required": ["topic", "area_code"]
              },
              "example": {
                "topic": "acidification",
                "area_code": "lechang",
                "target_ph": 6.0
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "$ref": "#/components/schemas/CountyDiagnosis"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/report/summary": {
      "post": {
        "tags": ["报告"],
        "summary": "报告摘要",
        "description": "将诊断结果或模型执行结果整理为稳定、可拆解的汇报摘要",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CountyDiagnosis"
              },
              "description": "诊断结果或模型执行结果（必须包含 status: ok）"
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "$ref": "#/components/schemas/ReportSummary"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
